# Copy to .env (never commit .env). All values have safe development defaults.
PORT=3000
# Comma-separated list of allowed front-end origins.
CORS_ORIGIN=http://localhost:5173
# REQUIRED in production: long random string used to sign guest tokens.
JWT_SECRET=change-me
# PostgreSQL (docker compose up -d postgres). Leave empty to run without saving games.
DATABASE_URL=postgresql://minefall:minefall@localhost:5442/minefall
