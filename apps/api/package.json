{
  "name": "@minefall/api",
  "version": "0.1.0",
  "private": true,
  "description": "Minefall real-time game server (NestJS + Socket.IO).",
  "scripts": {
    "prebuild": "pnpm --filter @minefall/shared build",
    "build": "nest build",
    "predev": "pnpm --filter @minefall/shared build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "pnpm --filter @minefall/shared build",
    "typecheck": "tsc --noEmit",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@minefall/shared": "workspace:*",
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.2",
    "@nestjs/platform-socket.io": "^12.6.2",
    "@nestjs/websockets": "^12.6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.3",
    "@types/node": "^26.6.11",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  }
}
