# Docker Compose settings (copy to .env next to docker-compose.yml). All optional locally.

# Host ports (change if they clash with other projects).
WEB_PORT=8090
POSTGRES_PORT=5442

# REQUIRED in production: strong random values.
POSTGRES_PASSWORD=minefall
JWT_SECRET=change-me-to-a-long-random-string

# Public URL of the site (used for CORS), e.g. https://minefall.example.com
PUBLIC_URL=http://localhost:8090
